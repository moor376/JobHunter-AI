# PostgreSQL Database URL
DATABASE_URL=postgresql://postgres:postgres_password@localhost:5432/jobhunter_ai?schema=public

# Application Environment
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# AI Provider (Optional: Google Gemini API Key)
GEMINI_API_KEY=

# Google OAuth 2.0 (Optional: Gmail sending credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/email/oauth/google/callback

# Email Provider Mode (auto | live | simulation)
GMAIL_MODE=auto
TOKEN_ENCRYPTION_SECRET=jobhunter-ai-secure-token-vault-key-32b

# Job Polling Worker Configuration
JOB_WORKER_ENABLED=false
JOB_WORKER_INTERVAL_MINUTES=30
JOB_WORKER_MATCH_THRESHOLD=60

# URLs and Security
APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
UPLOAD_DIR=uploads
MAX_RESUME_SIZE_BYTES=5242880
